{
  "name": "dsh-sidebar-organizer",
  "version": "0.4.3",
  "private": false,
  "description": "DSH 侧栏面板整理器：长按拖动排序、拖入/拖出「更多」收纳、键盘排序",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "NOTICE.md",
    "NOTICE.en.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "panel",
    "drag-and-drop",
    "reorder",
    "organizer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TLEWA/dsh-sidebar-organizer.git"
  },
  "homepage": "https://github.com/TLEWA/dsh-sidebar-organizer#readme",
  "bugs": {
    "url": "https://github.com/TLEWA/dsh-sidebar-organizer/issues"
  },
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react"
      ]
    }
  }
}
